# ============================================
# Supabase Configuration (PostgreSQL)
# ============================================
# Option 1: Use full connection string (Recommended)
# Get this from: Supabase Dashboard > Settings > Database > Connection string > URI
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Option 2: Use individual components (if not using SUPABASE_DATABASE_URL above)
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_DB_PASSWORD=[YOUR-DATABASE-PASSWORD]
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_HOST=db.[PROJECT-REF].supabase.co
# SUPABASE_DB_PORT=5432

# SQL Debugging (set to 'true' to see SQL queries in console)
SQL_ECHO=false

# ============================================
# MongoDB Configuration (Legacy - Optional)
# ============================================
MONGO_URI=mongodb://localhost:27017/fkgis

# ============================================
# Neo4j Configuration
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ============================================
# Application Configuration
# ============================================
# Add any other application-specific environment variables here
